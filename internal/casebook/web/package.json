{
  "name": "casebook-page",
  "private": true,
  "version": "0.0.0",
  "description": "casebook's browser bundle. DEV-TIME ONLY: the built output lives in internal/casebook/serve/assets and is committed; `npm run build` rebuilds it. Nothing at runtime needs node.",
  "type": "module",
  "scripts": {
    "postinstall": "npm run kit-types",
    "kit-types": "KIT_DIR=$(go list -m -f '{{.Dir}}' github.com/schuettc/tools-common) && cp \"$KIT_DIR/localweb/page/assets/kit.d.ts\" .",
    "typecheck": "tsc",
    "fmt": "prettier --write \"*.mjs\" \"*.ts\"",
    "fmt:check": "prettier --check \"*.mjs\" \"*.ts\"",
    "lint": "eslint \"*.mjs\" \"*.ts\" --max-warnings 0",
    "build:js": "esbuild entry.ts --bundle --format=esm --external:/_kit/* --charset=utf8 --outfile=../serve/assets/casebook.js",
    "build:css": "esbuild casebook.css --bundle --charset=utf8 --outfile=../serve/assets/casebook.css",
    "probe": "node probe.mjs",
    "build": "npm run --silent build:js && npm run --silent build:css && node probe.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "globals": "17.11.0",
    "playwright-core": "1.56.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
